# -------------------------------------------------
# Ollama Cloud configuration (local instance)
# -------------------------------------------------
# The API key will be set by the developer in a .env file.
OLLAMA_CLOUD_API_URL=https://api.ollama.com/v1/chat/completions
OLLAMA_CLOUD_MODEL=nemotron-3-nano:30b-cloud
OLLAMA_CLOUD_API_KEY=your-token-here